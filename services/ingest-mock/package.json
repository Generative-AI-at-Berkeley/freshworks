{
  "name": "@fwcoach/ingest-mock",
  "version": "0.0.0",
  "private": true,
  "description": "Stand-in for the Freshworks telemetry pipeline: same OTLP payload, same auth shape, same limits. Never deployed anywhere real.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --env-file-if-exists=../../.env --conditions=@fwcoach/source src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@fwcoach/contracts": "workspace:*",
    "fastify": "5.12.8",
    "prom-client": "15.1.3",
    "zod": "4.6.7"
  },
  "files": [
    "dist"
  ]
}
