{
  "name": "@fwcoach/api",
  "version": "0.0.0",
  "private": true,
  "description": "Query API, rollup jobs and directory sync over self-hosted Postgres.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --env-file-if-exists=../../.env --conditions=@fwcoach/source src/main.ts",
    "start": "node dist/main.js",
    "job": "tsx --env-file-if-exists=../../.env --conditions=@fwcoach/source src/jobs/cli.ts"
  },
  "dependencies": {
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.3.0",
    "@fwcoach/contracts": "workspace:*",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "prom-client": "15.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fwcoach/testkit": "workspace:*",
    "@types/pg": "8.23.1"
  },
  "files": [
    "dist"
  ]
}
