# Copy to .env.local. Next reads it for pnpm dev:dashboard. Never commit .env.local.

# The fwcoach query API (pnpm dev:api). Leave blank to run on the built-in
# synthetic org in src/mock, which needs nothing else running.
API_BASE_URL=

# Who the dashboard acts as until OIDC sign-in exists. Sent as X-Dev-Engineer,
# which the API accepts only with API_AUTH_MODE=local. Required when
# API_BASE_URL is set.
DASHBOARD_DEV_ENGINEER=
DASHBOARD_DEV_ORG_UNIT=
# Optional. platform_admin for the admin views.
DASHBOARD_DEV_ROLES=

# How long the /api proxy waits for the API before answering 504.
API_TIMEOUT_MS=10000

# The dev identity is refused under next start (production) unless this is
# true. Only for the local compose demo, never a real deployment.
DASHBOARD_ALLOW_DEV_IDENTITY=false
