# Copy to .env for local development. Every value here is a local default.
# Real Freshworks endpoints and credentials never go in this repo (see docs/decisions/0007).

# Postgres from docker compose.
# dbmate runs migrations as the owner. Services connect as fwcoach_api, which is
# not the owner, so row-level security applies to them. Never point a service
# at the owner URL.
DATABASE_URL=postgres://fwcoach:fwcoach@localhost:5432/fwcoach?sslmode=disable
APP_DATABASE_URL=postgres://fwcoach_api:fwcoach_api@localhost:5432/fwcoach?sslmode=disable

# development | test | production. Unset means production, which refuses
# API_AUTH_MODE=local. Local dev needs development.
NODE_ENV=development

# Query API
API_PORT=8080
# local | oidc. local trusts the X-Dev-Engineer header and must never run outside dev.
API_AUTH_MODE=local
# /metrics listener, kept off the public port (docs/observability.md).
API_METRICS_HOST=127.0.0.1
API_METRICS_PORT=9464
# Set to write job metrics for node_exporter's textfile collector.
# JOB_METRICS_DIR=./.job-metrics
# Lets local auth run under another NODE_ENV (the compose demo uses staging).
# Ignored in production: local auth is always refused there.
API_ALLOW_HEADER_AUTH=false
# Limits and timeouts. Defaults are in services/api/src/config.ts.
# API_RATE_LIMIT_MAX=600
# API_DB_STATEMENT_TIMEOUT_MS=15000
# Send HSTS. Only when TLS terminates in front of the API.
# API_HSTS=false

# Mock ingest (stands in for the Freshworks telemetry pipeline)
INGEST_PORT=4318
INGEST_METRICS_HOST=127.0.0.1
INGEST_METRICS_PORT=9465

# Collector
FWCOACH_INGEST_URL=http://localhost:4318
# Relative to where the collector runs (packages/collector for pnpm scripts). Gitignored.
FWCOACH_STATE_DIR=./.fwcoach
# Bearer token for ingest-mock only.
FWCOACH_DEV_TOKEN=dev-local
FWCOACH_FLUSH_INTERVAL_SECONDS=300
FWCOACH_BUFFER_MAX_BYTES=10485760
# L0 metrics | L1 structure | L2 content. L2 needs explicit, time-boxed consent.
FWCOACH_CONTENT_LEVEL=L1

# dbmate
DBMATE_MIGRATIONS_DIR=./db/migrations
DBMATE_NO_DUMP_SCHEMA=true
